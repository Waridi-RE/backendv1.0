
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
    @@map(name: "users")

    id String @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    photo String? @default("default.png")
    verified Boolean? @default(false)
    password String
    role RoleEnumType? @default(user)
    verificationCode String? @db.Text @unique
    createdAt DateTime @default(now())
    updateAt DateTime @updatedAt
    passwordResetToken String?
    passwordResetAt DateTime?
    @@unique([email, verificationCode])
    @@index([email, verificationCode])
    @@unique([email, verificationCode, passwordResetToken])
    @@index([email, verificationCode, passwordResetToken])
}

model Landlord{
  @@map(name: "landlord")
  id String @unique @default(uuid())
  first_name String @db.VarChar(255)
  other_names String @db.VarChar(255)
  house_name String @db.VarChar(255)
  location String @db.VarChar(255)
  description String @db.VarChar(255)
  createdAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

enum RoleEnumType {
    user
    admin
    tenant
    landlord
}
